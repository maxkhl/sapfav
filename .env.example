# Port, auf dem die App im Container lauscht und der auf dem Host veröffentlicht wird.
SAPFAV_PORT=8000

# Pfad der SQLite-Datenbank im Container. Muss im Volume /data liegen.
SAPFAV_DB=/data/tcodes.db

# Token für die MCP-Schnittstelle unter /mcp (Claude-Anbindung).
# Leer oder nicht gesetzt = Schnittstelle aus. Erzeugen mit: openssl rand -hex 32
SAPFAV_MCP_TOKEN=
